{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "version": "1.2.0",
    "scripts": {
        "build": "tsc && vite build && vite build --ssr",
        "dev": "vite",
        "serve:dev": "php artisan serve --host=momentum.joehunter.local --port=80",
        "open": "start chrome http://momentum.joehunter.local",
        "hot": "concurrently \"npm run dev\" \"npm run serve:dev\" \"npm run open\""
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^18.13.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react-oxc": "^0.4.3",
        "autoprefixer": "^10.4.12",
        "axios": ">=1.11.0 <=1.14.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sass": "^1.99.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.0.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@vitejs/plugin-react": "^6.0.1",
